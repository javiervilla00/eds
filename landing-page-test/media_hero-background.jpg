    <coral-dialog-content><form id="newtemplateform" data-imagepath="/content/dam/itv/car-image/toyota-corolla-cross-gr-sport.jpg" enctype="application/x-www-form-urlencoded" method="POST" fieldtrackingidentifier="" trackingelement="new template" class="coral-Form coral-Form--vertical"><div  class="coral-Form-fieldwrapper"><label id="label_2de268fd-0aec-47e8-93c3-abb0a3e89ece" class="coral-Form-fieldlabel">Template Name</label><input  class="coral-Form-field" id="newtemplatename" type="text" autocomplete="off" labelledby="label_2de268fd-0aec-47e8-93c3-abb0a3e89ece" value="" data-foundation-validation="createtemplate.txtinp" data-validation="createtemplate.txtinp" is="coral-textfield"></div><div  class="coral-Form-fieldwrapper"><label id="label_addb92bb-fecf-4993-8a0e-40576c143f73" class="coral-Form-fieldlabel">Canvas Width</label><coral-numberinput  class="coral-Form-field" id="templateWidth" value="" labelledby="label_addb92bb-fecf-4993-8a0e-40576c143f73 description_addb92bb-fecf-4993-8a0e-40576c143f73" data-foundation-validation="createtemplate.dimensioninp" data-validation="createtemplate.dimensioninp"></coral-numberinput><coral-icon class="coral-Form-fieldinfo" icon="infoCircle" tabindex="0" aria-labelledby="description_addb92bb-fecf-4993-8a0e-40576c143f73" aria-describedby="description_addb92bb-fecf-4993-8a0e-40576c143f73" alt="description"></coral-icon>
                <coral-tooltip target="_prev" placement="left" id="description_addb92bb-fecf-4993-8a0e-40576c143f73">
                    <coral-tooltip-content>Canvas Width, leave empty to match image width</coral-tooltip-content>
                </coral-tooltip></div><div  class="coral-Form-fieldwrapper"><label id="label_d14c526d-d8e1-4d48-bf6f-ba613a0208ab" class="coral-Form-fieldlabel">Canvas Height</label><coral-numberinput  class="coral-Form-field" id="templateHeight" value="" labelledby="label_d14c526d-d8e1-4d48-bf6f-ba613a0208ab description_d14c526d-d8e1-4d48-bf6f-ba613a0208ab" data-foundation-validation="createtemplate.dimensioninp" data-validation="createtemplate.dimensioninp"></coral-numberinput><coral-icon class="coral-Form-fieldinfo" icon="infoCircle" tabindex="0" aria-labelledby="description_d14c526d-d8e1-4d48-bf6f-ba613a0208ab" aria-describedby="description_d14c526d-d8e1-4d48-bf6f-ba613a0208ab" alt="description"></coral-icon>
                <coral-tooltip target="_prev" placement="left" id="description_d14c526d-d8e1-4d48-bf6f-ba613a0208ab">
                    <coral-tooltip-content>Canvas Width, leave empty to match image height</coral-tooltip-content>
                </coral-tooltip></div></form></coral-dialog-content><coral-dialog-footer><button  id="create-template-submit" type="submit" disabled="" autocomplete="off" is="coral-button" variant="primary" trackingfeature="" trackingelement="create" tracking="ON">Create</button><link rel="stylesheet" href="/libs/dam/gui/components/s7dam/template/clientlibs.lc-ef22ded7ce085462538bdeb3beb90324-lc.min.css" type="text/css">
<script src="/libs/dam/gui/components/s7dam/template/clientlibs.lc-bc69827961dffba92e8c5a984e835b76-lc.min.js"></script>


</coral-dialog-footer></coral-dialog></div><coral-dialog  id="messageClipboard" class="foundation-toggleable" variant="info" closable="on" backdrop="static">
    <coral-dialog-header>URL</coral-dialog-header>
    <coral-dialog-content><form class="messageClipboardBody coral-Form coral-Form--vertical" fieldtrackingidentifier=""><textarea  class="coral-Form-field message foundation-layout-util-resizable-none" rows="5" data-foundation-validation="" data-validation="" is="coral-textarea"></textarea><span >Select and copy text</span></form></coral-dialog-content><coral-dialog-footer><button  coral-close="" type="button" autocomplete="off" is="coral-button" variant="primary" trackingfeature="" trackingelement="close" tracking="ON">Close</button></coral-dialog-footer></coral-dialog></div>
            </div>
        </div>
    </div></div>
<coral-dialog id="unified-shell-impersonation" closable="on" variant="default">

    <form class="u-coral-padding-horizontal coral-Form coral-Form--vertical" id="unified-shell-impersonation" action="/mnt/overlay/granite/ui/content/shell/userproperties.impersonate.html" method="post">
        <coral-dialog-header>
            Select user to impersonate as
        </coral-dialog-header>
        <coral-dialog-content style="height:250px">
            <input class="foundation-setter" type="hidden" name="originalURI" data-foundation-setter-var="window.location">
            <input type="hidden" name="action" value="impersonate">
            
            <input type="hidden" name="_charset_" value="utf-8">
            <div class="coral-Form-fieldwrapper">
                <div class="foundation-layout-actionfield coral-Form-field">
                    <foundation-autocomplete class="foundation-layout-actionfield-field"
                                             name="userId"
                                             required=""
                                             placeholder="Search User"
                                             data-foundation-validation="">
                        <coral-overlay foundation-autocomplete-suggestion=""
                                       class="foundation-picker-buttonlist"
                                       data-foundation-picker-buttonlist-src="/mnt/overlay/granite/ui/content/coral/foundation/authorizable/autocomplete/suggestion{.offset,limit}.html?_charset_=utf-8&amp;selector=user&amp;serviceUserFilter=exclude&amp;impersonableUserFilter=includeonly&amp;query={query}"></coral-overlay>
                        <coral-taglist foundation-autocomplete-value="" name="userId" class="foundation-autocomplete-taglist">
                            <coral-tag value=""></coral-tag>
                        </coral-taglist>
                        <input class="foundation-field-related" type="hidden" name="userId@Delete">
                    </foundation-autocomplete>
                </div>
            </div>
            
            <span id="invalid-impersonation-error" hidden="true">Invalid User</span>
        </coral-dialog-content>
        <coral-dialog-footer>
            <button type="button" is="coral-button" variant="secondary" coral-close>Cancel</button>
            <button class="foundation-layout-actionfield-action foundation-layout-util-nominwidth foundation-validation-bind"
                    type="submit"
                    variant="primary"
                    autocomplete="off"
                    is="coral-button"
                    trackingfeature=""
                    trackingelement="ok"
                    tracking="ON">Impersonate</button>
        </coral-dialog-footer>
    </form>
</coral-dialog>

<script src="/libs/unifiedshell/components/impersonate/clientlibs/impersonate.lc-7ac9463219285c2232789f925895a747-lc.min.js"></script>


</body>
</html>
